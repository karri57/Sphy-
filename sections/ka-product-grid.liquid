{%- liquid
  assign collection_obj = collections[section.settings.collection]
  if collection_obj == blank
    assign collection_obj = collections.frontpage
  endif
  assign thirty_days_ago = 'now' | date: '%s' | minus: 2592000
-%}

<div class="ka-pgrid">
  {%- if section.settings.heading != blank -%}
    <div class="ka-pgrid__header">
      <h2 class="ka-pgrid__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.view_all_link != blank -%}
        <a href="{{ section.settings.view_all_link }}" class="ka-pgrid__view-all">View All</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="ka-pgrid__inner">
    {%- for product in collection_obj.products limit: section.settings.max_products -%}
      {%- assign first_variant = product.selected_or_first_available_variant -%}

      {%- assign is_sale = false -%}
      {%- assign is_new = false -%}
      {%- if product.compare_at_price > product.price -%}
        {%- assign is_sale = true -%}
      {%- elsif product.tags contains 'new' or product.tags contains 'New' or product.tags contains 'NEW' -%}
        {%- assign is_new = true -%}
      {%- else -%}
        {%- assign created_ts = product.created_at | date: '%s' | plus: 0 -%}
        {%- if created_ts > thirty_days_ago -%}
          {%- assign is_new = true -%}
        {%- endif -%}
      {%- endif -%}

      {%- assign color_index = nil -%}
      {%- for opt in product.options -%}
        {%- assign opt_low = opt | downcase -%}
        {%- if opt_low == 'color' or opt_low == 'colour' -%}
          {%- assign color_index = forloop.index0 -%}
        {%- endif -%}
      {%- endfor -%}

      <div class="ka-pgrid__item">
        <div class="ka-pgrid__card">

          <!-- Badge + star overlay -->
          <div class="ka-pgrid__card-top">
            <div class="ka-pgrid__badge-wrap">
              {%- if is_sale -%}
                <span class="ka-pgrid__badge ka-pgrid__badge--sale">Sale</span>
              {%- elsif is_new -%}
                <span class="ka-pgrid__badge ka-pgrid__badge--new">New In</span>
              {%- endif -%}
            </div>
            <button class="ka-pgrid__star" aria-label="Save {{ product.title | escape }}" type="button">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            </button>
          </div>

          <!-- Image track: swipeable via CSS scroll-snap -->
          <a href="{{ product.url }}" class="ka-pgrid__img-link" aria-label="{{ product.title | escape }}">
            <div class="ka-pgrid__img-track">
              {%- if product.images != blank -%}
                {%- for img in product.images limit: 4 -%}
                  <div class="ka-pgrid__img-slide">
                    {{
                      img
                      | image_url: width: 600
                      | image_tag:
                        class: 'ka-pgrid__img',
                        alt: img.alt | default: product.title,
                        loading: forloop.first | iif: 'eager', 'lazy',
                        sizes: '(min-width: 750px) 25vw, 50vw',
                        widths: '300, 450, 600'
                    }}
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div class="ka-pgrid__img-slide">
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'ka-pgrid__img ka-pgrid__placeholder' }}
                </div>
              {%- endif -%}
            </div>
          </a>

          <!-- Image dots — always render to keep all card heights equal -->
          <div class="ka-pgrid__cdots" aria-hidden="true">
            {%- assign dot_count = product.images.size | at_least: 1 | at_most: 4 -%}
            {%- for i in (1..dot_count) -%}
              <span class="ka-pgrid__cdot{% if forloop.first %} is-act{% endif %}"></span>
            {%- endfor -%}
          </div>

        </div><!-- /.ka-pgrid__card -->

        <!-- Info below card -->
        <div class="ka-pgrid__info">
          <a href="{{ product.url }}" class="ka-pgrid__name-link">
            <p class="ka-pgrid__name">{{ product.title | truncate: 30 }}</p>
          </a>
          <div class="ka-pgrid__btm-row">
            <p class="ka-pgrid__price">
              {%- if is_sale -%}
                <span class="ka-pgrid__price-sale">{{ product.price | money }}</span>
                <span class="ka-pgrid__price-compare">{{ product.compare_at_price | money }}</span>
              {%- else -%}
                {{ product.price | money }}
              {%- endif -%}
            </p>
            {%- if product.variants.size == 1 -%}
              {%- form 'product', product, class: 'ka-pgrid__atc-form' -%}
                <input type="hidden" name="id" value="{{ first_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button
                  type="submit"
                  class="ka-pgrid__atc-btn"
                  aria-label="Add {{ product.title | escape }} to cart"
                  {%- unless first_variant.available %} disabled{%- endunless -%}
                >ADD TO CART</button>
              {%- endform -%}
            {%- else -%}
              <a href="{{ product.url }}" class="ka-pgrid__atc-btn">ADD TO CART</a>
            {%- endif -%}
          </div>

          {%- if color_index != nil -%}
            <div class="ka-pgrid__swatches" aria-label="Available colors">
              {%- assign seen = '' -%}
              {%- for variant in product.variants -%}
                {%- assign c = variant.options[color_index] -%}
                {%- unless seen contains c -%}
                  {%- assign seen = seen | append: c | append: '|' -%}
                  {%- assign c_css = c | downcase | replace: ' ', '' -%}
                  <span class="ka-pgrid__swatch" title="{{ c }}" style="background:{{ c_css }};"></span>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

        </div>
      </div><!-- /.ka-pgrid__item -->

    {%- else -%}
      <p class="ka-pgrid__empty">No products found.</p>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .ka-pgrid {
    background: #FFFFFF;
    padding: 32px 16px 72px;
  }

  .ka-pgrid__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .ka-pgrid__title {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #111111;
    margin: 0;
  }

  .ka-pgrid__view-all {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.72rem;
    color: #111111;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Grid ─────────────────────────────────────── */
  .ka-pgrid__inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 10px;
    row-gap: 28px;
    max-width: 1280px;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .ka-pgrid { padding: 40px 32px 96px; }
    .ka-pgrid__inner {
      grid-template-columns: repeat(4, 1fr);
      column-gap: 16px;
      row-gap: 36px;
    }
  }

  /* ── Card ─────────────────────────────────────── */
  .ka-pgrid__item {
    display: flex;
    flex-direction: column;
  }

  .ka-pgrid__card {
    position: relative;
    background: #EFEFEF;
    display: flex;
    flex-direction: column;
  }

  /* ── Badge + star overlay ─────────────────────── */
  .ka-pgrid__card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 8px 8px 0;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    pointer-events: none;
  }

  .ka-pgrid__badge-wrap { min-height: 18px; }

  .ka-pgrid__badge {
    display: inline-block;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }

  .ka-pgrid__badge--new { color: #111111; }
  .ka-pgrid__badge--sale { color: #CC0000; }

  .ka-pgrid__star {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: #888888;
    display: flex;
    align-items: center;
    pointer-events: auto;
    flex-shrink: 0;
  }

  .ka-pgrid__star:hover { color: #111111; }

  /* ── Image track (swipeable) ───────────────────── */
  .ka-pgrid__img-link {
    display: block;
    text-decoration: none;
    padding-top: 28px;
  }

  .ka-pgrid__img-track {
    display: flex;
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ka-pgrid__img-track::-webkit-scrollbar { display: none; }

  .ka-pgrid__img-slide {
    flex: 0 0 100%;
    width: 100%;
    scroll-snap-align: start;
  }

  .ka-pgrid__img,
  .ka-pgrid__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    object-position: center;
    transition: opacity 0.2s ease;
  }

  .ka-pgrid__img-link:hover .ka-pgrid__img { opacity: 0.85; }

  /* ── Card image dots ──────────────────────────── */
  .ka-pgrid__cdots {
    display: flex;
    justify-content: center;
    gap: 4px;
    padding: 8px 0 10px;
    pointer-events: none;
  }

  .ka-pgrid__cdot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(0,0,0,0.18);
    flex-shrink: 0;
  }

  .ka-pgrid__cdot.is-act { background: #111111; }

  /* ── Info below card ──────────────────────────── */
  .ka-pgrid__info {
    margin-top: 8px;
    padding: 0 2px;
  }

  .ka-pgrid__name-link {
    display: block;
    text-decoration: none;
    color: inherit;
    margin-bottom: 5px;
  }

  .ka-pgrid__name {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    color: #111111;
    margin: 0;
    line-height: 1.35;
  }

  /* ── Price row + ATC ──────────────────────────── */
  .ka-pgrid__btm-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin-bottom: 6px;
  }

  @media screen and (min-width: 750px) {
    .ka-pgrid__btm-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .ka-pgrid__price {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    color: #111111;
    margin: 0;
    flex-shrink: 0;
  }

  .ka-pgrid__price-sale { color: #CC0000; margin-right: 3px; }
  .ka-pgrid__price-compare { color: #999; text-decoration: line-through; }

  .ka-pgrid__atc-form { margin: 0; padding: 0; line-height: 1; width: 100%; }

  @media screen and (min-width: 750px) {
    .ka-pgrid__atc-form { width: auto; }
  }

  .ka-pgrid__atc-btn {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    background: #111111;
    color: #FFFFFF !important;
    border: none;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 10px 12px;
    cursor: pointer;
    text-decoration: none !important;
    white-space: nowrap;
    -webkit-appearance: none;
    transition: background 0.15s;
    line-height: 1;
  }

  @media screen and (min-width: 750px) {
    .ka-pgrid__atc-btn {
      width: auto;
      flex-shrink: 0;
    }
  }

  .ka-pgrid__atc-btn:hover:not([disabled]) { background: #333333; color: #FFFFFF !important; text-decoration: none !important; }
  .ka-pgrid__atc-btn[disabled] { opacity: 0.38; cursor: not-allowed; }

  /* ── Color swatches ───────────────────────────── */
  .ka-pgrid__swatches {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .ka-pgrid__swatch {
    display: inline-block;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 1.5px solid rgba(0,0,0,0.15);
    flex-shrink: 0;
  }

  /* ── Empty state ──────────────────────────────── */
  .ka-pgrid__empty {
    grid-column: 1 / -1;
    text-align: center;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    color: #888888;
    padding: 64px 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "New Arrivals"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Products to show",
      "min": 2,
      "max": 48,
      "step": 2,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Product Grid"
    }
  ]
}
{% endschema %}
