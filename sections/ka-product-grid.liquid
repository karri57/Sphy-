{%- liquid
  assign collection_obj = collections[section.settings.collection]
  if collection_obj == blank
    assign collection_obj = collections.frontpage
  endif
-%}

<div class="ka-pgrid color-{{ section.settings.color_scheme }}">
  <div class="ka-pgrid__inner">
    {%- for product in collection_obj.products limit: section.settings.max_products -%}
      <div class="ka-pgrid__item">
        <a href="{{ product.url }}" class="ka-pgrid__img-link" tabindex="-1" aria-label="{{ product.title }}">
          {%- if product.featured_image != blank -%}
            {{
              product.featured_image
              | image_url: width: 900
              | image_tag:
                class: 'ka-pgrid__img',
                alt: product.featured_image.alt | default: product.title,
                loading: 'lazy',
                width: product.featured_image.width,
                height: product.featured_image.height,
                sizes: '(min-width: 750px) 25vw, 50vw',
                widths: '300, 450, 600, 900'
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'ka-pgrid__img ka-pgrid__img--placeholder' }}
          {%- endif -%}
        </a>

        <div class="ka-pgrid__info">
          <a href="{{ product.url }}" class="ka-pgrid__text-link">
            <p class="ka-pgrid__name">{{ product.title }}</p>
            {%- unless product.variants.first.title == 'Default Title' -%}
              <p class="ka-pgrid__variant">{{ product.variants.first.title }}</p>
            {%- endunless -%}
            <p class="ka-pgrid__price">{{ product.price | money }}</p>
          </a>

          {%- render 'quick-add', product: product, section_id: section.id -%}
        </div>
      </div>
    {%- else -%}
      <p class="ka-pgrid__empty">No products found in this collection.</p>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .ka-pgrid {
    padding: 24px 16px 72px;
  }

  .ka-pgrid__inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px 16px;
    max-width: 1280px;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .ka-pgrid {
      padding: 48px 32px 96px;
    }

    .ka-pgrid__inner {
      grid-template-columns: repeat(4, 1fr);
      gap: 56px 24px;
    }
  }

  .ka-pgrid__item {
    display: flex;
    flex-direction: column;
  }

  .ka-pgrid__img-link {
    display: block;
    text-decoration: none;
  }

  .ka-pgrid__img,
  .ka-pgrid__img--placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    object-position: center;
    transition: opacity 0.2s ease;
  }

  .ka-pgrid__img-link:hover .ka-pgrid__img { opacity: 0.87; }

  .ka-pgrid__info {
    margin-top: 18px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .ka-pgrid__text-link {
    display: block;
    text-decoration: none;
    width: 100%;
  }

  .ka-pgrid__name {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.63rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #141414;
    margin: 0 0 3px;
    line-height: 1.4;
  }

  .ka-pgrid__variant {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.63rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #141414;
    margin: 0 0 4px;
    line-height: 1.4;
  }

  .ka-pgrid__price {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.63rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: #141414;
    margin: 0 0 12px;
  }

  /* ── Override quick-add: remove overlay, show below price ── */
  .ka-pgrid quick-add-component.quick-add {
    position: static !important;
    inset: auto !important;
    z-index: auto !important;
    pointer-events: all !important;
    width: 100%;
    background: transparent !important;
    display: block !important;
  }

  .ka-pgrid .quick-add__product-form-component {
    width: 100%;
  }

  .ka-pgrid .quick-add__product-form-component form {
    width: 100%;
  }

  .ka-pgrid .quick-add__button,
  .ka-pgrid .quick-add__button--add,
  .ka-pgrid .quick-add__button--choose {
    /* Reset overlay positioning */
    position: static !important;
    right: auto !important;
    bottom: auto !important;
    inset: auto !important;
    /* Reset overlay styles */
    opacity: 1 !important;
    display: block !important;
    backdrop-filter: none !important;
    border-radius: 0 !important;
    height: auto !important;
    pointer-events: all !important;
    /* Button appearance */
    width: 100% !important;
    background: #141414 !important;
    background-image: none !important;
    color: #F4F2EE !important;
    border: 1px solid #141414 !important;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
    font-size: 0.58rem !important;
    font-weight: 400 !important;
    letter-spacing: 0.18em !important;
    text-transform: uppercase !important;
    padding: 11px 8px !important;
    cursor: pointer !important;
    transition: background 0.2s, color 0.2s !important;
  }

  .ka-pgrid .quick-add__button:hover,
  .ka-pgrid .quick-add__button--add:hover,
  .ka-pgrid .quick-add__button--choose:hover {
    background: #F4F2EE !important;
    color: #141414 !important;
  }

  /* Hide the ATC cart icon — text only */
  .ka-pgrid .add-to-cart-icon { display: none !important; }

  /* Show the text content properly */
  .ka-pgrid .add-to-cart-text__content { display: block !important; }
  .ka-pgrid .add-to-cart-text__content > span > span { padding: 0 !important; }

  /* Visually hidden live region — don't show */
  .ka-pgrid .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    clip: rect(0,0,0,0) !important;
  }

  .ka-pgrid__empty {
    grid-column: 1 / -1;
    text-align: center;
    font-size: 0.82rem;
    color: #8A8A86;
    padding: 64px 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Select which collection to display"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products to show",
      "min": 2,
      "max": 48,
      "step": 2,
      "default": 24
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Product Grid"
    }
  ]
}
{% endschema %}
